# Server
NODE_ENV=development
PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=the_draft_app
DB_PASSWORD=change-me
DB_NAME=the_draft

# Session cookie
SESSION_COOKIE_NAME=draft_sid
SESSION_DAYS=7

# Set to 1 only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=0

# Admin bootstrap account (used by `npm run create-admin` only)
ADMIN_NAME=Draft Editor
ADMIN_EMAIL=editor@example.com
ADMIN_PASSWORD=change-this-to-a-long-password
