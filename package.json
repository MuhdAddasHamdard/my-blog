{
  "name": "the-draft",
  "version": "1.0.0",
  "private": true,
  "description": "The Draft — an independent editorial blog with a public magazine and a private admin desk.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "migrate": "npm run migrate -w backend",
    "seed": "npm run seed -w backend",
    "create-admin": "npm run create-admin -w backend",
    "verify": "npm run verify -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
